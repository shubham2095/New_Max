# Copy this file to ".env" in the same folder and fill in real values.
# .env is where your REAL secrets live — never commit it.

# --- Gmail SMTP settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_character_app_password

# Where submissions should be emailed to (defaults to newmaxinquiry@gmail.com if unset)
MAIL_TO=newmaxinquiry@gmail.com

# Optional: change the port the server runs on (default 5000)
# PORT=5000